generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  email    String @unique
  password String
  roleId   String @map("role_id") @db.Uuid

  role Role @relation(fields: [roleId], references: [id])

  @@map("accounts")
}

model Role {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  accounts Account[]

  @@map("roles")
}
